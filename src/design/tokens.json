    "body": "\"Instrument Sans\", sans-serif",
    "numeric": "\"Instrument Sans\", sans-serif"
  },
  "font-weight": {
    "regular": "400",
    "medium": "500",
    "bold": "700"
  },
  "text": {
    "xs": "12px",
