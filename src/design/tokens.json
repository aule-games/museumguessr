    "ink-inverse": "#132036",
    "line": "#7a8ca8",
    "accent": "#c8ef5c",
    "accent-ink": "#132036",
    "accent-hover": "#d9f68e",
    "disabled": "#2a3c5c",
    "disabled-ink": "#b3c0d4",
    "focus": "#8fd3ff",
    "kept": "#1b46c7",
    "made": "#a40f72",
    "guess": "#1f2a3a",
    "answer-line": "#1b46c7",
    "guess-line": "#4a5566",
    "full-marks-area": "rgba(16, 140, 90, 0.12)",
