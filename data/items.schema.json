{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aule-games.github.io/museumguessr/items.schema.json",
  "title": "ItemsFile",
  "description": "MuseumGuessr content. Fields are grouped by question: kept, made, when. See docs/content.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Item"
      }
    }
  },
  "$defs": {
    "HttpsUrl": {
      "title": "HttpsUrl",
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "SourcedText": {
      "title": "SourcedText",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "source_url"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "$ref": "#/$defs/HttpsUrl"
        }
      }
    },
    "Kept": {
      "title": "Kept",
      "description": "Where it is kept today: the holding museum and its city.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "museum",
        "city",
        "country",
        "lat",
        "lng",
        "source_url"
      ],
      "properties": {
        "museum": {
          "type": "string",
          "minLength": 1
        },
        "city": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 1
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "source_url": {
          "$ref": "#/$defs/HttpsUrl"
        }
      }
    },
    "Made": {
      "title": "Made",
      "description": "Place of creation as named by the museum record (not the depicted place or find spot). Coordinates are the Wikidata P625 of that place item.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "place",
        "country",
        "precision",
        "wikidata_url",
        "lat",
        "lng",
        "source_url"
      ],
      "properties": {
        "place": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 1
        },
        "precision": {
          "enum": [
            "city",
            "region",
            "country"
          ]
        },
        "wikidata_url": {
          "type": "string",
          "pattern": "^https://www\\.wikidata\\.org/wiki/Q[0-9]+$"
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "source_url": {
          "$ref": "#/$defs/HttpsUrl"
        },
        "note": {
          "description": "Optional one-line clarification shown as the Made row's reason, e.g. 'Shows Venice; painted in London'.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 90
        },
        "full_marks_km": {
          "description": "Optional full-marks radius for this item, capped by its precision level (ENG12).",
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        }
      }
    },
    "When": {
      "title": "When",
      "description": "Date range from the museum record. Historical years, negative = BCE, no year 0.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "label",
        "source_url"
      ],
      "properties": {
        "start": {
          "type": "integer",
          "not": {
            "const": 0
          }
        },
        "end": {
          "type": "integer",
          "not": {
            "const": 0
          }
        },
        "label": {
          "description": "The museum's own wording, e.g. 'ca. 1665'.",
          "type": "string",
          "minLength": 1
        },
        "source_url": {
          "$ref": "#/$defs/HttpsUrl"
        },
        "note": {
          "description": "Optional one-line clarification shown in the When row's details, e.g. when the museum's own record gives more than one date.",
          "type": [
            "string",
            "null"
          ],
          "maxLength": 130
        }
      }
    },
    "Photo": {
      "title": "Photo",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_url",
        "file_url",
        "author",
        "licence",
        "pd_basis"
      ],
      "properties": {
        "source_url": {
          "description": "Page that states the photo's licence.",
          "$ref": "#/$defs/HttpsUrl"
        },
        "file_url": {
          "description": "Direct URL of the original image file.",
          "$ref": "#/$defs/HttpsUrl"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "licence": {
          "enum": [
            "CC0 1.0",
            "Public domain",
            "PD-Art",
            "CC BY 2.0",
            "CC BY 2.5",
            "CC BY 3.0",
            "CC BY 4.0",
            "CC BY-SA 2.0",
            "CC BY-SA 2.5",
            "CC BY-SA 3.0",
            "CC BY-SA 4.0"
          ]
        },
        "pd_basis": {
          "description": "Why the artwork itself is public domain.",
          "type": "string",
          "minLength": 1
        },
        "crop_note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Item": {
      "title": "Item",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "difficulty",
        "object_type",
        "alt_neutral",
        "caption",
        "record_url",
        "wikidata_url",
        "kept",
        "made",
        "when",
        "moved",
        "journey_fact",
        "facts",
        "photo",
        "conflicts",
        "contested",
        "claimant_source",
        "heritage_image_law",
        "retrieved"
      ],
      "properties": {
        "id": {
          "description": "Opaque two- or three-digit id, never derived from the title or place, never reused, even after the item is retired (DS6, ENG10, V1-12). The image is images/<id>.jpg.",
          "type": "string",
          "pattern": "^[0-9]{2,3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 70
        },
        "difficulty": {
          "description": "1 easy, 2 medium, 3 hard (V1-08). Editorial at first and confirmed on the batch contact sheet, then recalibrated from per-item points (docs/content.md \"Difficulty\"). Difficulty 1 needs a city-level made place, no record conflicts and no contested claim.",
          "enum": [
            1,
            2,
            3
          ]
        },
        "object_type": {
          "description": "What kind of object it is, for the pool's spread rules (V1-12).",
          "enum": [
            "painting",
            "print",
            "drawing",
            "sculpture",
            "vessel",
            "textile",
            "architecture",
            "other"
          ]
        },
        "alt_neutral": {
          "description": "Alt text during the round: material, form, figures, composition; no title, artist, place, culture or date (A1, DS29).",
          "type": "string",
          "minLength": 10
        },
        "caption": {
          "description": "One short subject line shown on the photo during the round: what the object is and shows; the same rules as alt_neutral (DS37, A1).",
          "type": "string",
          "minLength": 10,
          "maxLength": 70
        },
        "record_url": {
          "description": "The holding museum's own object record.",
          "$ref": "#/$defs/HttpsUrl"
        },
        "wikidata_url": {
          "description": "The object's own Wikidata item, or null when none exists.",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^https://www\\.wikidata\\.org/wiki/Q[0-9]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "kept": {
          "$ref": "#/$defs/Kept"
        },
        "made": {
          "$ref": "#/$defs/Made"
        },
        "when": {
          "$ref": "#/$defs/When"
        },
        "moved": {
          "description": "True when the holding city lies outside the made place.",
          "type": "boolean"
        },
        "journey_fact": {
          "description": "How it reached its current collection; documented transfers with sources, gaps stated as 'not documented' (E3, PV1). Required when moved is true.",
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "text",
                "source_url"
              ],
              "properties": {
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240
                },
                "source_url": {
                  "$ref": "#/$defs/HttpsUrl"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "facts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "source_url"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "source_url": {
                "$ref": "#/$defs/HttpsUrl"
              }
            }
          }
        },
        "photo": {
          "$ref": "#/$defs/Photo"
        },
        "conflicts": {
          "description": "Disagreements between the museum record and Wikidata; the museum record wins.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contested": {
          "description": "Under a public restitution claim with a cited source (V8).",
          "type": "boolean"
        },
        "claimant_source": {
          "description": "The claimant's published source, shown next to the museum's account (PV1). Required when contested is true.",
          "oneOf": [
            {
              "$ref": "#/$defs/SourcedText"
            },
            {
              "type": "null"
            }
          ]
        },
        "heritage_image_law": {
          "description": "True when held in or made in Italy or Greece (H1).",
          "type": "boolean"
        },
        "retrieved": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "moved": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "journey_fact": {
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "contested": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "claimant_source": {
                "type": "object"
              }
            }
          }
        }
      ]
    }
  }
}
