{
  "name": "museumguessr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "prepare": "node scripts/setup.mjs prepare",
    "setup:check": "node scripts/setup.mjs check",
    "tokens": "node scripts/tokens.mjs",
    "tokens:check": "node scripts/tokens.mjs --check",
    "typecheck": "tsc -p . && tsc -p worker",
    "types": "node scripts/types.mjs",
    "test": "npm run -s typecheck && node scripts/types.mjs --check && node scripts/tokens.mjs --check && node scripts/items.mjs check && vitest run && npm run -s test:design",
    "items:check": "node scripts/items.mjs check",
    "items:new": "node scripts/items.mjs new",
    "items:add-image": "node scripts/items.mjs add-image",
    "items:promote": "node scripts/items.mjs promote",
    "items:swap": "node scripts/items.mjs swap",
    "items:retire": "node scripts/items.mjs retire",
    "items:sheet": "node scripts/items.mjs sheet",
    "items:record": "node scripts/items.mjs record",
    "dev": "vite",
    "build": "vite build",
    "build:deploy": "node scripts/build.mjs",
    "preview": "vite preview",
    "build:e2e": "node scripts/build.mjs --build-id e2e && node scripts/build.mjs --build-id e2e --board-test",
    "test:e2e": "npm run -s build:e2e && playwright test",
    "lint": "eslint src tests scripts worker && stylelint \"src/**/*.css\"",
    "check:build": "node scripts/check-build.mjs",
    "verify": "node scripts/verify.mjs",
    "release:check": "node scripts/release-scan.mjs",
    "deploy": "node scripts/deploy.mjs",
    "rollback": "node scripts/rollback.mjs",
    "live:check": "node scripts/live-check.mjs",
    "cf:bootstrap": "node scripts/cf-bootstrap.mjs",
    "names:block": "node scripts/names.mjs block",
    "board:off": "node scripts/board.mjs off",
    "board:dark": "node scripts/board.mjs dark",
    "board:on": "node scripts/board.mjs on",
    "board:list": "node scripts/board.mjs list",
    "board:hide": "node scripts/board.mjs hide",
    "board:unhide": "node scripts/board.mjs unhide",
    "board:purge-smoke": "node scripts/board.mjs purge-smoke",
    "board:tail": "node scripts/board.mjs tail",
    "worker:dev": "node scripts/worker-dev.mjs",
    "test:design": "node --test tests/design/*.test.mjs",
    "design:build": "node scripts/design-directions.mjs",
    "design:check": "node scripts/design-directions.mjs --check",
    "design:browser": "node scripts/check-design-browser.mjs",
    "design:review:built": "node tests/design/review-built.mjs"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "maplibre-gl": "6.12.0",
    "photoswipe": "5.4.4",
    "posthog-js": "1.438.1"
  },
  "devDependencies": {
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@maplibre/maplibre-gl-style-spec": "26.4.4",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/geojson": "7946.0.16",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.12.0",
    "happy-dom": "20.14.5",
    "json-schema-to-typescript": "16.0.0",
    "sharp": "0.35.5",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0",
    "svgo": "4.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "core-js": false,
    "fsevents": false
  }
}
