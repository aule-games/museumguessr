// The museumguessr.com Worker (W1; docs/ops.md "Hosting and limits").
// Workers static assets serve dist/; only /api/* runs the Worker first.
// tests/unit/wrangler-config.test.ts guards every value below.
{
  "$schema": "worker/node_modules/wrangler/config-schema.json",
  "name": "museumguessr",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // The game's only address; www redirects at the zone (docs/ops.md).
  "routes": [{ "pattern": "museumguessr.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // No invocation logs (v1 privacy rule): only the explicit 5xx line, read through board:tail.
  "observability": { "enabled": false, "logs": { "enabled": false, "invocation_logs": false } },
  "upload_source_maps": false,
  "send_metrics": false,
  // npm run deploy sets the build's commit with --var WORKER_VERSION:<sha>.
  // TURNSTILE_HOSTNAME is the hostname siteverify must report here; local
  // wrangler dev overrides it (and TURNSTILE_TEST_KEYS) for Cloudflare's test keys.
  "vars": { "WORKER_VERSION": "dev", "TURNSTILE_HOSTNAME": "museumguessr.com" },
  // The board database (worker/migrations). npm run cf:bootstrap -- --board
  // creates it and prints its id, a public value to put here and commit;
  // local wrangler dev uses a local database whatever the id says.
  "d1_databases": [
    { "binding": "DB", "database_name": "museumguessr", "database_id": "964c3ca2-04c3-4a07-bb8a-0dbafe9b262a", "migrations_dir": "worker/migrations" }
  ],
  // Rate-limit bindings (ENG15; the numbers are in src/api/limits.ts).
  "ratelimits": [
    { "name": "IP_LIMIT", "namespace_id": "1201", "simple": { "limit": 30, "period": 60 } },
    { "name": "NEW_ROW_LIMIT", "namespace_id": "1202", "simple": { "limit": 5, "period": 60 } },
    { "name": "KEY_LIMIT", "namespace_id": "1203", "simple": { "limit": 3, "period": 60 } }
  ],
  // The eight-week purge, hourly; it skips the two hours each side of Monday 00:00 UTC.
  "triggers": { "crons": ["17 * * * *"] }
  // Secrets are never in this file: TURNSTILE_SECRET (cf:bootstrap pipes it to
  // wrangler secret put) and BOARD_FORCE_OFF (only in an emergency).
}
