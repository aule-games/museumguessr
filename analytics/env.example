# Copy to a file OUTSIDE the repository (for example ~/.config/museumguessr.env)
# and fill in. Never commit the filled-in file.
# A personal API key with "query:read" on the project; it starts with phx_.
POSTHOG_PERSONAL_API_KEY=phx_REPLACE_ME
# The PostHog project that receives the events (shared with other side projects).
POSTHOG_PROJECT_ID=304461
POSTHOG_API=https://eu.posthog.com
